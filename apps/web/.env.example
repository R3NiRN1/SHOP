# Prisma database connection
# Example: postgresql://user:password@localhost:5432/shopb?schema=public
DATABASE_URL=
PRISMA_ACCELERATE_URL=

# NextAuth/credentials configuration.
# AUTH_SECRET must be at least 32 characters; ADMIN_PASSWORD at least 16.
AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public ordering contact. Required for enquiry links in production.
SHOP_CONTACT_EMAIL=

# Trust x-forwarded-for/x-real-ip only when the deployment proxy is known to overwrite/sanitize them.
TRUST_PROXY_HEADERS=false

# Optional: expose readiness dependency details. Leave false on a public endpoint unless operationally required.
READINESS_DETAILS=false

# Development/demo only. Ignored when NODE_ENV=production.
ENABLE_STARTER_CATALOG=false
