generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  GROWER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Grower {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  region    String?
  stories   Story[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Variety {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  species     String?
  description String?
  price       Decimal? @db.Decimal(10, 2)
  stock       Int?
  published   Boolean  @default(false)
  stories     Story[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, name])
}

model Story {
  id        String   @id @default(cuid())
  title     String
  content   String
  growerId  String?
  varietyId String?
  grower    Grower?  @relation(fields: [growerId], references: [id], onDelete: SetNull)
  variety   Variety? @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  consentAt DateTime @default(now())
  source    String?
}
