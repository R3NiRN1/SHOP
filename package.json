{
  "name": "shopb",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "preflight": "node ./scripts/run-preflight.js",
    "setup": "pnpm install && pnpm rebuild && pnpm -C apps/web exec prisma generate",
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "start": "pnpm -C apps/web start",
    "lint": "pnpm -C apps/web lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "sharp"
    ]
  }
}
