{
  "name": "shopb",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "20.19.0",
    "pnpm": "10.0.0"
  },
  "scripts": {
    "preflight": "node ./scripts/run-preflight.js",
    "doctor": "node ./scripts/doctor.mjs",
    "setup": "pnpm install && pnpm rebuild && pnpm -C apps/web exec prisma generate",
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "start": "pnpm -C apps/web start",
    "lint": "pnpm -C apps/web lint",
    "typecheck": "pnpm -C apps/web typecheck",
    "ci:local": "pnpm install --frozen-lockfile && pnpm -C apps/web exec prisma generate && pnpm -C apps/web lint && pnpm -C apps/web typecheck && pnpm -C apps/web build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
